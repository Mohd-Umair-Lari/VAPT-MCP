mcp_servers:
  vapt:
    command: "python3"
    args:
      - "/home/kali/Projects/VAPT-MCP/mcp_server.py"
    timeout: 120
    connect_timeout: 10
    tools:
      include:
        - vapt_get_scope
        - vapt_start_assessment
        - vapt_get_status
        - vapt_get_report
        - vapt_get_history
      resources: false
      prompts: false
