# VAPT MCP Production Environment Variables
# Copy to .env and customize for your deployment

# ============================================================
# Application Settings
# ============================================================
VAPT_ALLOW_PRIVATE_IPS=true
VAPT_RATE_PER_SECOND=100
VAPT_MAX_CONCURRENT=50
VAPT_MAX_REDIRECTS=10
VAPT_MAX_RESPONSE_BYTES=5242880
VAPT_REQUEST_BUDGET=100000
VAPT_TIMEOUT_SECONDS=30

# ============================================================
# Security Settings
# ============================================================
# Enable DNS rebinding protection (recommended for production)
# VAPT_ENABLE_DNS_REBINDING_PROTECTION=true

# Enforce scope validation (set false for unrestricted scanning)
# VAPT_ENFORCE_SCOPE=false

# Require approval tokens for exploitation (set false for auto-approve)
# VAPT_REQUIRE_EXPLOIT_APPROVAL=false

# ============================================================
# Logging & Monitoring
# ============================================================
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# ============================================================
# HTTP Mode Settings (if running HTTP server)
# ============================================================
# MCP_HTTP_PORT=8000
# MCP_HTTP_HOST=0.0.0.0

# ============================================================
# Database (optional - for persistent job storage)
# ============================================================
# DATABASE_URL=postgresql://user:pass@localhost/vapt_mcp

# ============================================================
# Redis (optional - for distributed scanning)
# ============================================================
# REDIS_URL=redis://localhost:6379/0

# ============================================================
# Cloudflare/External Access
# ============================================================
# PUBLIC_DOMAIN=vapt.yourdomain.com
# CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here